# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# Every value here is also baked into docker-compose.yml as a default, so
# the stack runs even if you skip this step. Only needed to override
# something (e.g. a port already in use on your machine).

# --- Postgres ---
POSTGRES_USER=eval_service
POSTGRES_PASSWORD=eval_service
POSTGRES_DB=eval_service
POSTGRES_PORT=5432

# --- Backend (FastAPI, served by uvicorn) ---
BACKEND_PORT=8000

# --- Frontend (Vite dev server) ---
FRONTEND_PORT=5173

# --- Cluster (Phase 3) ---
# Placeholder values only -- see docs/IMPLEMENTATION_PHASES.md Appendix C
# and decision D9. For local dev against the real cluster, your actual
# .env needs the validated values, not these placeholders:
#   CLUSTER_SSH_HOST=85.234.64.146   (not login-6 -- that's the on-cluster
#                                      alias; this is what's reachable from
#                                      a laptop, and what Phase 0 validated)
#   CLUSTER_SSH_KEY_HOST_PATH=<absolute path to your private key>
#   CLUSTER_SSH_KNOWN_HOSTS_HOST_PATH=<absolute path, e.g. /Users/you/.ssh/known_hosts>
# Both HOST_PATH vars are docker-compose mount sources, not Settings
# fields -- compose doesn't expand `~`, so they must be absolute.
CLUSTER_SSH_HOST=login-6
CLUSTER_SSH_USER=naresh
CLUSTER_SSH_PORT=22
CLUSTER_PROXY_JUMP=login-6
SLURM_PARTITION=main
SLURM_WALLTIME_SECONDS=7200
CLUSTER_LOG_ROOT=/home/shared/eval-service/logs
CLUSTER_SSH_KEY_HOST_PATH=/path/to/your/cluster_ssh_key
CLUSTER_SSH_KNOWN_HOSTS_HOST_PATH=/path/to/your/known_hosts

# --- Harness (Phase 4) ---
# OUTPUT_ROOT_HOST_PATH is a docker-compose mount source like the two
# HOST_PATH vars above, not a Settings field -- it's what `docker run -v`
# is given when the backend spawns a harness container, because that
# container is created by the host daemon and never sees the backend's
# own mount namespace. The default (./runs, repo-relative) works with
# zero setup; only override it if you want run outputs somewhere else.
OUTPUT_ROOT_HOST_PATH=./runs
HARNESS_IMAGE=registry.local/evalscope:2ce95c3
HARNESS_DOCKER_NETWORK=evaluation-service_default
